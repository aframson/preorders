# Hosted Supabase (replace with your project values from
# Dashboard → Project Settings → API). Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# service_role secret — required for Vercel build + server actions. Not the anon key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local Supabase instead (comment out the hosted block above):
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# App -----------------------------------------------------------------------
# Used to build shareable batch links and Paystack callback URLs, so it has to
# be the real public origin in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paystack ------------------------------------------------------------------
# Flip this to switch the whole app between test and live money.
# Keep NEXT_PUBLIC_PAYSTACK_MODE in sync with PAYSTACK_MODE.
PAYSTACK_MODE="test"
NEXT_PUBLIC_PAYSTACK_MODE="test"

# Test keys (Dashboard → Settings → API Keys → Test)
PAYSTACK_TEST_SECRET_KEY="sk_test_..."
PAYSTACK_TEST_PUBLIC_KEY="pk_test_..."
NEXT_PUBLIC_PAYSTACK_TEST_PUBLIC_KEY="pk_test_..."
# Optional. Defaults to the test secret key (Paystack signs webhooks with it).
PAYSTACK_TEST_WEBHOOK_SECRET=""

# Live keys (Dashboard → Settings → API Keys → Live)
PAYSTACK_LIVE_SECRET_KEY="sk_live_..."
PAYSTACK_LIVE_PUBLIC_KEY="pk_live_..."
NEXT_PUBLIC_PAYSTACK_LIVE_PUBLIC_KEY="pk_live_..."
PAYSTACK_LIVE_WEBHOOK_SECRET=""

# Webhook URL (set in both Test and Live Paystack dashboards):
#   {NEXT_PUBLIC_SITE_URL}/api/webhooks/paystack
# Local: use `ngrok http 3000` (or similar) and paste that origin + path.

# Trigger.dev ---------------------------------------------------------------
# Optional. Cutoffs still enforce in-process via `isPastCutoff` without this.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# Email --------------------------------------------------------------------
# Production: Resend (https://resend.com). Local: Mailpit SMTP on 54325 when
# smtp_port is enabled in supabase/config.toml (view mail at :54324).
RESEND_API_KEY=""
EMAIL_FROM="Preorders <orders@yourdomain.com>"
# Optional SMTP override (defaults to 127.0.0.1:54325 in development).
# EMAIL_SMTP_HOST="127.0.0.1"
# EMAIL_SMTP_PORT="54325"
